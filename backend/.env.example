# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Database URI (Do not commit production credentials)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/goldenwing?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/goldenwing?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRE=30d
